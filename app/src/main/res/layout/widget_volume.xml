<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top bar: Mode + All Sliders -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Volume"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/wBtnMode"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn"
            android:paddingHorizontal="10dp"
            android:text="Normal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/wBtnPanel"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn"
            android:paddingHorizontal="10dp"
            android:text="All"
            android:textAllCaps="false"
            android:textColor="#64B5F6"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Media Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wTvMedia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Media: 5/15"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/wBtnMediaDown"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/wBtnMediaUp"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Call Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wTvCall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Call: 4/7"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/wBtnCallDown"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/wBtnCallUp"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Ringtone Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wTvRing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ring: 5/7"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/wBtnRingDown"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/wBtnRingUp"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>