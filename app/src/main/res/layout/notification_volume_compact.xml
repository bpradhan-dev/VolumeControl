<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/ncRow0"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ncLabel0"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="Call 4/7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ncMinus0"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_notif_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/notif_btn_fg"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/ncProg0"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/notif_track_bg"
            android:progressTint="@color/notif_accent" />

        <Button
            android:id="@+id/ncPlus0"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/notif_btn_fg"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ncRow1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ncLabel1"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:text="Ring 5/7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ncMinus1"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_notif_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="-"
            android:textColor="@color/notif_btn_fg"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/ncProg1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:progressBackgroundTint="@color/notif_track_bg"
            android:progressTint="@color/notif_accent" />

        <Button
            android:id="@+id/ncPlus1"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_btn"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textColor="@color/notif_btn_fg"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>